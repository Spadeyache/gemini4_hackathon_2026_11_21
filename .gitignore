# Dependencies
node_modules/
.pnp
.pnp.js

# Vite & TypeScript build outputs
dist/
dist-ssr/
*.local
*.tsbuildinfo
tsconfig.tsbuildinfo

# Environment variables & secrets (NEVER commit API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python cache & virtual environments (garment / texture helper scripts)
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
.venv/
venv/
ENV/

# OS & Editor metadata
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs & temporary diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Explicitly keep pre-baked 3D boutique textures & normalized garments tracked
# so teammates get an instant 60 FPS zero-latency showroom on `git clone`!
!public/
!public/assets/
!public/assets/**
