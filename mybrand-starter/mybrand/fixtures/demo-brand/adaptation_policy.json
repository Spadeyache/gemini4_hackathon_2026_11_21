{
  "dynamic": "maker→collector",
  "objective": "help each visitor find what fits them: look → inspect → add to cart",
  "levers": [
    {
      "path": "/hero_plinth/product_id",
      "allowed": "any product id"
    },
    {
      "path": "/zones/{zone}/slots/{slot}/product_id",
      "allowed": "ids of products assigned to {zone}"
    },
    {
      "path": "/zones/{zone}/lighting",
      "allowed": "ids in variant_pools.lighting"
    },
    {
      "path": "/zones/{zone}/signage",
      "allowed": "variant_pools.signage[{zone}], or a rewrite ≤60 chars with no new facts"
    },
    {
      "path": "/blurbs/{product}",
      "allowed": "0 or 1"
    },
    {
      "path": "/host_note",
      "allowed": "a rewrite ≤90 chars in the host's voice, no new facts"
    },
    {
      "path": "/guide_path/target_zone",
      "allowed": "any zone id"
    }
  ],
  "frozen": [
    "brand_core",
    "room",
    "entrance",
    "zone geometry",
    "fixtures",
    "prices",
    "variants",
    "product facts",
    "logo",
    "palette"
  ],
  "rules": [
    {
      "id": "r1",
      "priority": 1,
      "when": "inspects(tag:coffee) >= 2 AND current_zone == zone_table",
      "do": {
        "path": "/zones/zone_table/slots/s_table_1/product_id",
        "value": "top_product(tag:coffee, zone:zone_table)"
      },
      "why": "comparing coffee stoneware in daily table zone"
    },
    {
      "id": "r2",
      "priority": 2,
      "when": "inspects(tag:prints) >= 2 AND current_zone == zone_gallery",
      "do": {
        "path": "/zones/zone_gallery/slots/s_gallery_1/product_id",
        "value": "top_product(tag:prints, zone:zone_gallery)"
      },
      "why": "comparing woodblock kiln prints in gallery zone"
    },
    {
      "id": "r3",
      "priority": 3,
      "when": "add_to_cart(p_espresso_cup) >= 1",
      "do": {
        "path": "/hero_plinth/product_id",
        "value": "complement(p_espresso_cup)"
      },
      "why": "added espresso cup; surface pairing coffee piece on hero plinth"
    },
    {
      "id": "r4",
      "priority": 4,
      "when": "dwell_s(zone_gallery) >= 10 AND current_zone == zone_gallery",
      "do": {
        "path": "/zones/zone_gallery/lighting",
        "value": "gallery_spot"
      },
      "why": "lingering in gallery; shift lighting to focused gallery spotlight"
    },
    {
      "id": "r5",
      "priority": 5,
      "when": "look_s(p_ash_glaze_dripper) >= 3",
      "do": {
        "path": "/blurbs/p_ash_glaze_dripper",
        "value": 1
      },
      "why": "sustained look at dripper; flip blurb to practical brewing fit"
    },
    {
      "id": "r6",
      "priority": 6,
      "when": "quick_exits(zone_kiln) >= 1",
      "do": {
        "path": "/guide_path/target_zone",
        "value": "top_zone(dwell_s)"
      },
      "why": "skimmed kiln bench quickly; point guide path toward highest-dwell zone"
    }
  ],
  "limits": {
    "first_change_after_s": 12,
    "max_ops_per_change": 3,
    "cooldown_s": 8,
    "max_ops_per_session": 15,
    "lever_min_interval_s": 20,
    "deadline_ms": 2500
  }
}
