# Server only. Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Optional: your own dev store, to test M4 without the connect form
SHOPIFY_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Public base URL Shopify can reach for product images (tunnel or bucket)
PUBLIC_ASSET_BASE_URL=
