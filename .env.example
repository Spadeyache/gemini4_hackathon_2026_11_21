# ============================================================================
# Gemini 4 NYC Hackathon — Official @google/genai >= 3.2.0 Configuration
# Copy to `.env` (gitignored) and add your event API key
# ============================================================================

GEMINI_API_KEY=
# Optional additional teammate keys for automatic round-robin & 429 rate-limit failover:
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# 1. Heavy Multimodal Brand & Store Architect (Interactions API v1)
GEMINI_ARCHITECT_MODEL=gemini-4-carbon

# 2. Fast Parallel Synthetic Shopper Swarm Thoughts (Interactions API v1)
GEMINI_SWARM_MODEL=gemini-4-hydrogen

# 3. Messy Lifestyle / Model Garment Photo Normalizer (Interactions API v1)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# 4. Single-Pass Calibrated Shopper Yes/No (`noul`) & Mutation Router (`choice`) (Decisions API v1beta)
GEMINI_DECISIONS_MODEL=gemini-decision-1

# ============================================================================
# Bonus Track: Build with Commerce — Shopify (shop.dev)
# ============================================================================
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
