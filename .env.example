# ==============================================================================
# ATELIER 119 — Gemini 4 NYC Hackathon Environment Configuration
# Copy to `.env` before running locally:
#   macOS/Linux: cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env
# Note: The 3D showroom & pre-baked presets boot immediately even without keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini 4 Multi-Model & Decisions API (Teammate 1 & Teammate 2)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# Heavy multimodal Brand & Store Architect (URL / IG grid / garment -> StoreConfig JSON)
GEMINI_ARCHITECT_MODEL=gemini-4-carbon

# Fast parallel Synthetic Shopper Swarm (concurrent persona viewport/SKU evaluations)
GEMINI_SWARM_MODEL=gemini-4-neon

# Messy lifestyle / human-model / IG garment normalizer -> clean flat/hanger cutout
GEMINI_IMAGE_MODEL=gemini-4-hydrogen

# Gemini Decisions API routing, buy/skip/bounce gate & closed-loop StoreConfig mutation
GEMINI_DECISIONS_MODEL=gemini-decision-1

# ------------------------------------------------------------------------------
# 2. Shopify `shop.dev` Commerce Bonus Track (Teammate 3)
# ------------------------------------------------------------------------------
# Example: atelier-119-demo.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional local API server port (used by Vite `/api` proxy if running backend server)
PORT=8787
